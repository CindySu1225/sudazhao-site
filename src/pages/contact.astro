---
import Base from "../layouts/Base.astro";
import contactBg from "../assets/contact-bg.jpeg";
---

<Base title="联系方式" description="联系超现实治愈主义画家苏大朝。">
  <div
    class="contact__bg"
    aria-hidden="true"
    style={`background-image: url(${contactBg.src})`}
  >
  </div>
  <section class="container contact">
    <p class="eyebrow">联系方式</p>
    <h1>联系我</h1>
    <div class="contact__body">
      <p>关于作品购藏、委托创作或展览合作,欢迎与我联系:</p>
      <ul class="contact__list">
        <li><span class="label">邮箱</span><a href="mailto:497626009@qq.com">497626009@qq.com</a></li>
      </ul>
    </div>
  </section>
</Base>

<style>
  /* 与"关于我"页同款:用一幅作品的笔触作整页垫底背景,
     固定铺满视口、低透明度,两侧白纱变薄让线条更突出。 */
  .contact__bg {
    position: fixed;
    inset: 0;
    z-index: -1;
    background-size: cover;
    background-position: center;
    background-repeat: no-repeat;
    opacity: 0.6;
    pointer-events: none;
  }
  .contact__bg::after {
    content: "";
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to right,
      rgba(255, 255, 255, 0.12) 0%,
      rgba(255, 255, 255, 0.72) 32%,
      rgba(255, 255, 255, 0.72) 68%,
      rgba(255, 255, 255, 0.12) 100%
    );
  }
  .contact {
    position: relative;
    padding-block: clamp(2rem, 6vw, 5rem);
    max-width: 680px;
  }
  .contact__body {
    margin-top: 1.5rem;
    font-size: 1.05rem;
  }
  .contact__list {
    list-style: none;
    padding: 0;
    margin-top: 1.25rem;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }
  .contact__list li {
    display: flex;
    gap: 1rem;
  }
  .label {
    min-width: 7em;
    color: var(--color-text-muted);
  }
</style>
