---
import Base from "../layouts/Base.astro";
import contactBg from "../assets/contact-bg.jpeg";
---

<Base title="联系方式" description="联系超现实治愈主义画家苏大朝。">
  <div
    class="contact__bg"
    aria-hidden="true"
    style={`background-image: url(${contactBg.src})`}
  >
  </div>
  <section class="container contact">
    <p class="eyebrow">联系方式</p>
    <h1>联系我</h1>
    <div class="contact__body">
      <p>关于作品购藏、委托创作或展览合作,欢迎与我联系。</p>
      <a
        class="contact__qr"
        href="https://www.xiaohongshu.com/user/profile/57b9eba450c4b43f1db940e2"
        target="_blank"
        rel="noopener noreferrer"
      >
        <img src="/xhs-qr.svg" alt="苏大朝小红书二维码" width="150" height="150" />
        <span>扫码关注我的小红书或和我联系</span>
      </a>
    </div>
  </section>
</Base>

<style>
  /* 与"关于我"页同款:用一幅作品的笔触作整页垫底背景,
     固定铺满视口、低透明度,两侧白纱变薄让线条更突出。 */
  .contact__bg {
    position: fixed;
    inset: 0;
    z-index: -1;
    background-size: cover;
    background-position: center;
    background-repeat: no-repeat;
    opacity: 0.6;
    pointer-events: none;
  }
  .contact__bg::after {
    content: "";
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to right,
      rgba(255, 255, 255, 0.12) 0%,
      rgba(255, 255, 255, 0.72) 32%,
      rgba(255, 255, 255, 0.72) 68%,
      rgba(255, 255, 255, 0.12) 100%
    );
  }
  .contact {
    position: relative;
    padding-block: clamp(2rem, 6vw, 5rem);
    max-width: 680px;
  }
  .contact__body {
    margin-top: 1.5rem;
    font-size: 1.05rem;
  }
  .contact__qr {
    display: inline-flex;
    flex-direction: column;
    align-items: center;
    gap: 0.65rem;
    margin-top: 1.75rem;
    padding: 1rem;
    border: 1px solid var(--color-line);
    border-radius: 12px;
    background: color-mix(in srgb, var(--color-bg) 78%, transparent);
    font-size: 0.92rem;
    color: var(--color-text-muted);
    transition: border-color 0.2s, color 0.2s;
  }
  .contact__qr img {
    display: block;
    width: 150px;
    height: 150px;
  }
  .contact__qr:hover {
    border-color: var(--color-text);
    color: var(--color-text);
  }
</style>
